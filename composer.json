{
    "name": "licensify/client-sdk",
    "description": "Framework-agnostic PHP client SDK for the Licensify licensing API: signed license certificates, fail-closed offline grace and Ed25519 verification.",
    "keywords": [
        "licensing",
        "license",
        "sdk",
        "ed25519",
        "offline-grace"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Shaishad",
            "homepage": "https://license.shaishad.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-sodium": "*"
    },
    "require-dev": {
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/config": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "laravel/pint": "^1.27",
        "phpunit/phpunit": "^11.5|^12.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "Licensify\\Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Licensify\\Client\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "homepage": "https://license.shaishad.com",
    "support": {
        "issues": "https://github.com/syedshaishad/licensify-client-sdk/issues",
        "source": "https://github.com/syedshaishad/licensify-client-sdk",
        "docs": "https://license.shaishad.com/docs"
    },
    "suggest": {
        "illuminate/support": "Required for the Laravel bridge: service provider, facade, middleware and artisan command",
        "illuminate/contracts": "Required for the Laravel bridge"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Licensify\\Client\\Laravel\\LicenseServiceProvider"
            ],
            "aliases": {
                "License": "Licensify\\Client\\Laravel\\Facades\\License"
            }
        }
    }
}
